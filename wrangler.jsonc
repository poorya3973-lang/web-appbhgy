{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appbhgy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c1ace624-54d5-47f8-9dfd-7bf7e9f6f1d6","database_name": "web-appjuhyg" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a1f33db12cc44322967a9abe8cfa082f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
